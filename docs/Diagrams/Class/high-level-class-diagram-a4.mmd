%%{init: {"look":"classic","layout":"elk","theme":"base","fontSize":28,"fontFamily":"Arial Narrow","htmlLabels":false,"markdownAutoWrap":false,"themeCSS":".edgeTerminals{font-size:28px!important}","themeVariables":{"fontFamily":"Arial Narrow","fontSize":"28px","primaryColor":"#ffffff","primaryTextColor":"#111111","primaryBorderColor":"#333333","lineColor":"#333333"},"class":{"nodeSpacing":12,"rankSpacing":18,"padding":8,"diagramPadding":4},"elk":{"mergeEdges":false,"nodePlacementStrategy":"NETWORK_SIMPLEX","cycleBreakingStrategy":"GREEDY","forceNodeModelOrder":false}}}%%
classDiagram
    direction LR

    class assessment_results {
        -final_decision
        -deferral_reason
        +record_decision()
    }
    class request_allocations {
        -allocated_at
        +reserve()
    }
    class blood_units {
        -volume_ml
        -collection_status
        -separation_outcome
        +finish_collection()
        +record_separation()
    }
    class demand_forecasts {
        -forecast_date
        -predicted_units
        +validate()
    }
    class roles {
        -code
        +is_in_scope()
    }
    class blood_components {
        -component_type
        -abo_group
        -rh_factor
        -expires_at
        -processing_decision
        -status
        +record_processing()
        +is_available()
        +check_expiry()
    }
    class donations {
        -donation_reference
        -status
        +register()
        +print_ticket()
    }
    class lab_test_results {
        -status
        +finalize()
    }
    class staff_accounts {
        -name
        -email
        +authenticate()
    }
    class donor_profiles {
        -full_name
        -phone
        +update_profile()
    }
    class hospitals {
        -display_name
        +submit_request()
    }
    class component_disposals {
        -reason
        -disposed_at
        +record()
    }
    class forecast_runs {
        -status
        -dataset_version
        +generate()
        +retrieve_saved()
    }
    class staff_assignments {
        -role_id
        -removed_at
        +assign()
        +remove()
    }
    class requests {
        -component_type
        -abo_group
        -rh_factor
        -quantity_units
        -status
        +find_nearest_match()$
        +submit()
        +accept()
        +reject()
    }
    class blood_banks {
        -display_name
        +can_supply()
        +list_notices()
    }

    roles "1" -- "0..*" staff_assignments
    hospitals "0..1" -- "0..*" staff_assignments
    staff_assignments "0..*" -- "1" staff_accounts
    forecast_runs "1" -- "0..*" demand_forecasts
    staff_accounts "1" -- "0..*" lab_test_results
    blood_components "0..*" -- "1" donations
    blood_banks "1" -- "0..*" requests : addressed
    component_disposals "0..1" -- "1" blood_components
    requests "1" -- "0..*" request_allocations
    assessment_results "0..1" -- "1" donations
    blood_banks "1" -- "0..*" forecast_runs
    staff_accounts "1" -- "0..*" blood_units
    request_allocations "0..1" -- "1" blood_components
    component_disposals "0..*" -- "1" staff_accounts
    donor_profiles "1" -- "0..*" donations
    staff_accounts "1" -- "0..*" donations
    blood_banks "0..1" -- "0..*" requests : accepted
    blood_units "0..1" -- "1" donations
    hospitals "1" -- "0..*" requests
    blood_components "0..*" -- "1" blood_units
    blood_banks "1" -- "0..*" donations
    blood_banks "0..1" -- "0..*" staff_assignments
    requests "0..*" -- "1" staff_accounts
    staff_accounts "1" -- "0..*" assessment_results
    forecast_runs "0..*" -- "1" staff_accounts
    lab_test_results "0..1" -- "1" donations

