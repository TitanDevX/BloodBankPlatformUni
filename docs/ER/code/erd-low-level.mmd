    %% Low-level version of the supplied overview, extended with
    %% roles/staff_assignments, addressed-request routing, rejection audit and saved forecast records.
    %% Original table order follows the image from top to bottom.
    %% Mermaid controls final node positions, so it may route the same
    %% relationships differently from the draw.io layout.
    %% High-level relative table placement is preserved in erd-low-level.drawio.
    %% Nullable fields are marked in attribute comments.

    requests {
        bigint id PK
        string request_reference UK
        bigint hospital_id FK
        string patient_reference
        bigint submitted_by_staff_id FK
        string component_type
        string abo_group
        string rh_factor
        int quantity_units
        datetime needed_by_at
        string urgency
        string delivery_location
        string requester_contact
        string status
        datetime submitted_at
        bigint addressed_bank_id FK
        datetime matched_at
        string matching_policy_version
        bigint accepted_bank_id FK "nullable"
        bigint accepted_by_staff_id FK "nullable"
        datetime accepted_at "nullable"
        bigint rejected_by_staff_id FK "nullable for automatic rejection"
        datetime rejected_at "nullable"
        string rejection_reason "nullable"
        string rejection_source "nullable; manual or automatic"
    }

    hospitals {
        bigint id PK
        string public_id UK
        string display_name
        string address
        string contact_phone "nullable"
        string contact_email "nullable"
        decimal latitude "nullable"
        decimal longitude "nullable"
        boolean active
    }

    blood_units {
        bigint id PK
        bigint donation_id FK, UK
        string bag_reference UK "nullable until bag assigned"
        decimal volume_ml "nullable"
        string collection_status
        string collection_fail_reason "nullable"
        bigint started_by_staff_id FK
        datetime started_at
        bigint completed_by_staff_id FK "nullable"
        datetime completed_at "nullable"
        datetime quarantined_at "nullable"
        string separation_outcome "nullable"
        string separation_failure_reason "nullable"
        bigint separated_by_staff_id FK "nullable"
        datetime separated_at "nullable"
    }

    request_allocations {
        bigint id PK
        bigint request_id FK
        bigint blood_component_id FK, UK
        datetime allocated_at
    }

    component_disposals {
        bigint id PK
        bigint blood_component_id FK, UK
        bigint disposed_by_staff_id FK
        string reason
        datetime disposed_at
    }

    blood_components {
        bigint id PK
        string component_reference UK
        bigint donation_id FK
        bigint blood_unit_id FK
        string component_type
        decimal volume_ml
        string abo_group "nullable until verified"
        string rh_factor "nullable until verified"
        datetime expires_at
        string processing_decision
        datetime processed_at
        string status
        datetime created_at
        datetime released_at "nullable"
    }

    donor_profiles {
        bigint id PK
        string donor_reference UK
        string full_name
        date date_of_birth
        string national_id UK "nullable"
        string phone
        string address "nullable"
        datetime created_at
    }

    staff_accounts {
        bigint id PK
        string name
        string email UK
        string password_hash
        boolean active
        datetime created_at
    }

    roles {
        bigint id PK
        string code UK
        string display_name
        string scope
    }

    staff_assignments {
        bigint id PK
        bigint staff_account_id FK
        bigint role_id FK
        string scope
        bigint blood_bank_id FK "nullable"
        bigint hospital_id FK "nullable"
        bigint assigned_by_staff_id FK
        datetime assigned_at
        bigint removed_by_staff_id FK "nullable"
        datetime removed_at "nullable"
    }

    donations {
        bigint id PK
        string donation_reference UK
        bigint donor_profile_id FK
        bigint blood_bank_id FK
        bigint registered_by_staff_id FK
        string status
        datetime registered_at
    }

    blood_banks {
        bigint id PK
        string public_id UK
        string display_name
        string address
        string contact_phone "nullable"
        string contact_email "nullable"
        decimal latitude "nullable"
        decimal longitude "nullable"
        boolean active
    }

    lab_test_results {
        bigint id PK
        bigint donation_id FK, UK
        json results
        string status
        boolean requires_follow_up
        string follow_up_reason "nullable"
        string abo_group "nullable when Failed"
        string rh_factor "nullable when Failed"
        string failure_reason "nullable"
        bigint recorded_by_staff_id FK
        datetime completed_at
    }

    assessment_results {
        bigint id PK
        bigint donation_id FK, UK
        json answers
        decimal weight_kg
        decimal hemoglobin_g_dl
        int systolic_bp_mmhg
        int diastolic_bp_mmhg
        int pulse_bpm
        decimal temperature_c
        string final_decision
        string deferral_type "nullable"
        string deferral_reason "nullable"
        date deferral_until "nullable"
        bigint assessed_by_staff_id FK
        datetime assessed_at
    }

    forecast_runs {
        bigint id PK
        bigint blood_bank_id FK
        bigint requested_by_staff_id FK
        string status
        string idempotency_key
        string input_fingerprint
        datetime requested_at
        datetime started_at "nullable"
        datetime completed_at "nullable"
        datetime as_of
        string timezone
        date history_start "nullable until snapshot validation"
        date history_end
        date data_complete_through "nullable until completeness validation"
        date forecast_start
        int horizon_days
        string target_definition_version
        string dataset_version "nullable until snapshot validation"
        string feature_version
        string attribution_version
        string model_version
        string model_artifact_reference
        string model_checksum
        string snapshot_reference "nullable until snapshot creation"
        string snapshot_checksum "nullable until snapshot creation"
        string evaluation_report_reference "nullable before validation; approved evaluation required for production publication"
        json parameters
        json result_manifest
        json coverage
        json quality_flags
        string error_code "nullable"
        string error_message "nullable"
    }

    demand_forecasts {
        bigint id PK
        bigint forecast_run_id FK
        string component_type
        string abo_group
        string rh_factor
        date forecast_date
        decimal predicted_units
        decimal p10_units "nullable when no validated interval exists"
        decimal p50_units "nullable when no validated interval exists"
        decimal p90_units "nullable when no validated interval exists"
        string method
        string result_status
        string reason_code "nullable"
        json quality_flags
        datetime generated_at
    }

