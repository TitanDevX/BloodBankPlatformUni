@startuml AccessCheck_Activity
start
:User Requests Protected Route;
if (Is Bearer Token Present?) then (yes)
  :Validate Token Signature;
  if (Is Token Valid & Unexpired?) then (yes)
    :Fetch User Record;
    if (Is User Active?) then (yes)
      if (Does Role Match Allowed Roles?) then (yes)
        if (Is Organization Scope Permitted?) then (yes)
          if (Bank admin assigning a role?) then (yes)
            if (Same bank, different user, allowed bank staff role?) then (yes)
              :Grant Access to Role Change;
              stop
            else (no)
              :Return 403 Forbidden Error;
              stop
            endif
          else (no)
            :Grant Access to Route / Resource;
            stop
          endif
        else (no)
          :Return 403 Wrong Organization Error;
          stop
        endif
      else (no)
        :Return 403 Forbidden Error;
        stop
      endif
    else (no)
      :Return 403 Account Inactive Error;
      stop
    endif
  else (no)
    :Return 401 Unauthorized Error;
    stop
  endif
else (no)
  :Redirect to /login;
  stop
endif
@enduml
