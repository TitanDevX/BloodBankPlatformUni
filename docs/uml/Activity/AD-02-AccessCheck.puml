@startuml FR02_Identity_Activity
title FR-02 - Authentication and Role Access
start
if (Requested use case?) then (Log In - UC-02.1)
  :Enter and submit credentials;
  :Verify credentials against stored password hash;
  if (Credentials valid?) then (yes)
    if (Account active?) then (yes)
      :Authenticate user;
      :Establish session or token;
    else (no)
      :Reject login;
    endif
  else (no)
    :Reject login;
  endif
else (Log Out or Protected Operation)
  if (Log Out - UC-02.2?) then (yes)
    :Request logout using current session or token;
    :Invalidate current session or token;
    note right
      Precondition: A current session or token exists.
    end note
  else (Protected Operation - UC-02.3 / UC-02.4)
    :Request protected operation;
    :Check authentication;
    if (Authenticated?) then (yes)
    else (no)
      :Deny operation;
      stop
    endif
    if (Account active?) then (yes)
    else (no)
      :Deny access;
      stop
    endif
    if (Role permits operation?) then (yes)
    else (no)
      :Deny operation;
      stop
    endif
    if (Record organization scope permitted?) then (yes)
    else (no)
      :Deny operation;
      stop
    endif
    if (Bank Administrator assigning a role?) then (yes)
      :Check acting and target users' bank_id values;
      if (Same non-null bank_id?) then (yes)
      else (no)
        :Deny role change;
        :Leave target role unchanged;
        stop
      endif
      :Check requested target role;
      note right
        Permitted roles:
        bank_donor_collection
        bank_inventory
        bank_fulfillment
      end note
      if (One of the three permitted roles?) then (yes)
        :Assign requested role;
      else (no)
        :Deny role change;
        :Leave target role unchanged;
        stop
      endif
    else (no)
      :Execute permitted operation;
    endif
  endif
endif
stop
@enduml