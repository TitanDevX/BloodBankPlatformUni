@startuml
title FR-18 - Submit Blood Component Request - Activity Diagram

|Hospital Staff|
start
:Open the blood component request form;
:Enter patient details or reference,\ncomponent, ABO/Rh group, quantity,\nand other required information;
:Request a match;

|Server — Requests|
repeat
  :Validate request data and hospital scope;

  if (Data valid and hospital within authority?) then (Yes)
    |Server — Inventory|
    :Find the current match using current stock;

    if (Matching result can be determined?) then (Yes)
      if (A qualifying bank is found?) then (Yes)
        |Client|
        :Display the matched bank and match details\nwith Submit and Retry buttons;
      else (No)
        |Client|
        :Display a no-match message and Retry button\nwithout enabling Submit;
      endif
    else (No)
      |Client|
      :Explain that a match cannot be determined\nand display the Retry button;
    endif

  else (No)
    |Client|
    :Reject the operation and identify corrections;
    stop
  endif

  |Hospital Staff|
  if (A matched bank is displayed?) then (Yes)
    :Review the request details and displayed bank;
  endif

  if (Cancel before clicking Submit?) then (Yes)
    :Cancel the request;
    stop
  endif

  if (A matched bank is displayed and Submit selected?) then (Yes)
    :Click the submit button;

    |Server — Requests|
    :Recheck request data and hospital scope;

    if (Data valid and hospital within authority?) then (Yes)
      |Server — Inventory|
      :Reverify the displayed bank against\ncurrent request data and stock;

      if (Displayed bank is still a valid match?) then (Yes)
        |Server — Requests|
        :Save a Pending request linked to the patient,\nhospital and displayed matched bank,\nwith component, ABO/Rh, quantity\nand other required details;
        :Make a notice containing request details\navailable to authorized inventory staff\nat the addressed bank;

        |Client|
        :Display submission confirmation\nand Pending request status;
        stop

      else (No or cannot verify)
        |Client|
        :Clear the current match and disable Submit;
        :Display the submission problem\nand Retry button;
      endif

    else (No)
      |Client|
      :Reject submission and identify corrections;
      stop
    endif
  endif

  |Hospital Staff|
  backward :Click the retry button;
repeat while (Retry selected?) is (Yes) not (No)

stop
@enduml