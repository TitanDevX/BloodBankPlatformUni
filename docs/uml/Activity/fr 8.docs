@startuml
title FR-08 - Search Donor Profiles - Activity Diagram

skinparam monochrome true
skinparam shadowing false
skinparam conditionStyle InsideDiamond

|Receptionist|
start
:Open the donor search;

|Client|
:Display the donor search form;

|Receptionist|
:Enter available search criteria;
:Click the search button;

|Server — Donors|
:Validate the search criteria;

if (Search criteria are valid?) then (Yes)
  :Retrieve matching donor profiles;

  if (Retrieval succeeded?) then (Yes)

    if (Matching profiles were found?) then (Yes)
      |Client|
      :Display the matching profiles;

      |Receptionist|
      if (Multiple profiles were found?) then (Yes)
        :Compare matching profiles\nusing available information;
      endif

      :Check the donor's identity;
      :Identify the correct profile;
      stop

    else (No)
      |Client|
      :Display no matching profiles\nand the option to register the user;
      stop
    endif

  else (No)
    |Client|
    :Explain that profile retrieval failed;
    stop
  endif

else (No)
  |Client|
  :Explain the problem with\nthe search criteria;
  stop
endif

@enduml