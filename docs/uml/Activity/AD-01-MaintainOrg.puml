@startuml FR01_Organizations_Activity
title FR-01 - Maintain and View Organizations
start
:Select organization operation;
:Check authentication, permission and organization scope;
if (Access permitted?) then (yes)
  if (View organizations or details?) then (yes)
    :Retrieve permitted organizations or details;
    :Display organizations or details;
  else (no - administrator operation)
    :Select bank or hospital;
    if (Deactivate organization?) then (yes)
      :Set selected organization to inactive;
      :Preserve linked history and referenced records;
      :Display organization details;
    else (create or edit)
      repeat
        :Enter organization details or changes;
        :Submit data;
        :Validate data and check for duplicates;
        note right
          Active banks and requesting hospitals
          require validated latitude and longitude.
        end note
        if (Invalid or duplicate data?) then (yes)
          :Display error and return to form;
        endif
      repeat while (Invalid or duplicate data?) is (yes) not (no)
      :Save bank/hospital record or changes;
      :Preserve linked history when editing;
      :Return identifier and display organization details;
    endif
  endif
else (no)
  :Deny access;
endif
stop
@enduml