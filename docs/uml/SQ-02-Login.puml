@startuml Login_Sequence
autonumber
actor "User" as User
participant "Client (React)" as Client
participant "AuthController" as AuthCtrl
participant "AuthService" as AuthService
database "Database" as DB

User -> Client : Submit Credentials (email, password)
Client -> AuthCtrl : POST /api/login
activate AuthCtrl

AuthCtrl -> AuthService : attemptLogin(credentials)
activate AuthService

AuthService -> DB : Query User by Email
activate DB
DB --> AuthService : Return User Record (password_hash, active, scope)
deactivate DB

alt Account Inactive or Invalid Credentials
    AuthService --> AuthCtrl : Throw ValidationException
    AuthCtrl --> Client : 401 / 403 Error Response
    Client --> User : Show Error Message
else Valid Credentials & Active Account
    AuthService -> AuthService : Generate Sanctum Token
    AuthService --> AuthCtrl : Return Auth Payload (Token & User Scope)
    deactivate AuthService
    AuthCtrl --> Client : 200 OK (Token + User Object)
    deactivate AuthCtrl
    Client --> User : Redirect to Authorized Dashboard
end
@enduml