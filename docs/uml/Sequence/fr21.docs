@startuml
title FR-21 - Generate Demand Forecast - Sequence Diagram
hide footbox

actor "Blood Bank Administrator" as Admin

box "Client"
  boundary "DemandForecastPage" as Page
end box

box "Server — Analytics & AI"
  control "DemandForecastController\nPresentation" as Controller
  control "DemandForecastService\nBusiness Logic" as Service
  entity "ForecastModel\nData Access" as ForecastModel
end box

box "Server — Requests"
  control "RequestHistoryService\nBusiness Logic" as HistoryService
  entity "RequestModel\nData Access" as RequestModel
end box

database "Database" as DB

box "AI Service — Separate Deployment"
  control "ForecastingService" as AI
end box

Admin -> Page : requestDemandForecast()
activate Page
Page -> Page : displayForecastingInterface()
deactivate Page

loop Initial selection or another component/group, followed by an explicit Generate click

  Admin -> Page : selectComponentAndGroup(component, aboRh)
  activate Page
  deactivate Page

  Admin -> Page : clickGenerateButton()
  activate Page

  Page -> Controller : generateForecast(bankScope, component, aboRh)
  activate Controller

  Controller -> Service : generateForecast(currentUser, bankScope, component, aboRh)
  activate Service

  Service -> Service : authorizeBankScope(currentUser, bankScope)
  activate Service
  Service --> Service : scopeResult
  deactivate Service

  alt Bank scope permitted
    Service -> HistoryService : getSubmittedDemandHistory(bankScope, component, aboRh)
    activate HistoryService

    HistoryService -> RequestModel : getDemandAggregatesForAddressedBank(bankScope, component, aboRh)
    activate RequestModel

    RequestModel -> DB : readOriginalSubmittedDemandAggregates(\nbankScope, component, aboRh)
    activate DB
    DB --> RequestModel : historyResult
    deactivate DB

    RequestModel --> HistoryService : historyResult
    deactivate RequestModel

    HistoryService --> Service : historyResult
    deactivate HistoryService

    alt Historical demand retrieved successfully
      Service -> Service : prepareAndAssessForecastInput(historyResult.aggregates)
      activate Service
      Service --> Service : inputAssessment
      deactivate Service

      alt Preparation succeeded and data sufficient under approved policy
        Service -> AI : generateForecast(inputAssessment.aggregatedHistory,\ncomponent, aboRh, approvedForecastParameters)
        activate AI

        AI -> AI : runApprovedForecastingMethod()
        AI --> Service : forecastingOutcome
        deactivate AI

        Service -> Service : validateForecastingOutcome(forecastingOutcome)
        activate Service
        Service --> Service : forecastValidation
        deactivate Service

        alt Processing succeeded and forecast response valid
          Service -> ForecastModel : saveNewForecast(bankScope, component, aboRh,\nforecastingOutcome, identifyingInformation)
          activate ForecastModel

          ForecastModel -> DB : insertNewForecastAndResultsAtomically(\nbankScope, component, aboRh, predictions,\nmodelMetadata, identifyingInformation)
          activate DB
          DB --> ForecastModel : saveResult
          deactivate DB

          ForecastModel --> Service : saveResult
          deactivate ForecastModel

        else Processing failed or forecast response invalid
          Service -> Service : buildGenerationFailure(forecastValidation.reason)
        end

      else Insufficient data or preparation failed
        Service -> Service : buildGenerationFailure(inputAssessment.reason)
      end

    else Historical demand retrieval failed
      Service -> Service : buildGenerationFailure(historyResult.reason)
    end

  else Bank scope not permitted
    Service -> Service : buildGenerationFailure(scopeResult.reason)
  end

  Service --> Controller : generationResult
  deactivate Service

  Controller --> Page : generationResult
  deactivate Controller

  alt Complete forecast saved successfully
    Page -> Page : displayForecastResultOrCompletion(generationResult.savedForecast)
  else Generation failed
    Page -> Page : displayGenerationFailure(generationResult.reason)
  end

  deactivate Page
end

@enduml