@startuml
title FR-08 - Search Donor Profiles - Sequence Diagram

skinparam monochrome true
skinparam shadowing false
hide footbox

actor "Receptionist" as Receptionist

box "Client"
  boundary "DonorSearchPage" as Page
end box

box "Server — Donors"
  control "DonorProfileController\nPresentation" as Controller
  control "DonorProfileService\nBusiness Logic" as Service
  entity "DonorProfileModel\nData Access" as Model
end box

database Database as DB

Receptionist -> Page : openDonorSearch()
activate Page
Page -> Page : displayDonorSearchForm()
deactivate Page

Receptionist -> Page : enterSearchCriteria(searchCriteria)
activate Page
deactivate Page

Receptionist -> Page : clickSearchButton()
activate Page

Page -> Controller : searchDonorProfiles(searchCriteria)
activate Controller

Controller -> Service : searchDonorProfiles(searchCriteria)
activate Service

Service -> Service : validateSearchCriteria(searchCriteria)
activate Service
Service --> Service : validationResult
deactivate Service

alt Search criteria are valid

  Service -> Model : findMatchingDonorProfiles(searchCriteria)
  activate Model

  Model -> DB : readMatchingDonorProfiles(searchCriteria)
  activate DB
  DB --> Model : retrievalResult
  deactivate DB

  Model --> Service : retrievalResult
  deactivate Model

  Service -> Service : buildSearchResult(retrievalResult)
  activate Service
  Service --> Service : searchResult
  deactivate Service

else Search criteria are invalid

  Service -> Service : buildInvalidCriteriaResult(validationResult.problems)
  activate Service
  Service --> Service : searchResult
  deactivate Service

end

Service --> Controller : searchResult
deactivate Service

Controller --> Page : searchResult
deactivate Controller

alt Search criteria are invalid

  Page -> Page : displayInvalidCriteriaProblem(searchResult.problem)

else Profile retrieval failed

  Page -> Page : displayProfileRetrievalFailure(searchResult.problem)

else Retrieval succeeded and no matching profiles were found

  Page -> Page : displayNoMatchesAndRegistrationOption()

else Retrieval succeeded and matching profiles were found

  Page -> Page : displayMatchingProfiles(searchResult.profiles)

end

deactivate Page
@enduml