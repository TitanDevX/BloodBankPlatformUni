@startuml
title FR-22 - View Saved Forecast - Sequence Diagram
hide footbox

actor "Blood Bank Administrator" as Admin

box "Client"
  boundary "SavedForecastsPage" as Page
end box

box "Server — Analytics & AI"
  control "DemandForecastController\nPresentation" as Controller
  control "DemandForecastService\nBusiness Logic" as Service
  entity "ForecastModel\nData Access" as Model
end box

database "Database" as DB

Admin -> Page : requestSavedForecasts()
activate Page

Page -> Controller : listSavedForecasts()
activate Controller

Controller -> Service : listSavedForecasts(currentUser)
activate Service

Service -> Service : determinePermittedForecastScope(currentUser)
activate Service
Service --> Service : permittedScope
deactivate Service

Service -> Model : listSavedForecasts(permittedScope)
activate Model

Model -> DB : readSavedForecastSummaries(permittedScope)
activate DB
DB --> Model : listResult
deactivate DB

Model --> Service : listResult
deactivate Model

Service --> Controller : listResult
deactivate Service

Controller --> Page : listResult
deactivate Controller

alt List retrieved successfully and forecasts exist
  Page -> Page : displayAvailableForecasts(listResult.forecasts)

else List retrieved successfully and no forecasts exist
  Page -> Page : displayNoSavedForecastResults()

else List retrieval failed
  Page -> Page : displayForecastListLoadingFailure()
end

deactivate Page

opt List retrieved successfully and forecasts exist
  Admin -> Page : selectSavedForecast(forecastId)
  activate Page

  Page -> Controller : getSavedForecast(forecastId)
  activate Controller

  Controller -> Service : getSavedForecast(forecastId, currentUser)
  activate Service

  Service -> Service : determinePermittedForecastScope(currentUser)
  activate Service
  Service --> Service : currentPermittedScope
  deactivate Service

  Service -> Model : getSavedForecast(forecastId, currentPermittedScope)
  activate Model

  Model -> DB : readSavedForecastAndResults(forecastId, currentPermittedScope)
  activate DB
  DB --> Model : retrievalResult
  deactivate DB

  Model --> Service : retrievalResult
  deactivate Model

  Service -> Service : validateSelectedForecast(forecastId,\ncurrentPermittedScope, retrievalResult)
  activate Service
  Service --> Service : selectionResult
  deactivate Service

  Service --> Controller : selectionResult
  deactivate Service

  Controller --> Page : selectionResult
  deactivate Controller

  Page -> Page : clearPreviouslyDisplayedForecast()

  alt Requested forecast retrieved within current scope
    Page -> Page : displaySavedForecast(selectionResult.savedForecast.component,\nselectionResult.savedForecast.aboRh,\nselectionResult.savedForecast.scope,\nselectionResult.savedForecast.results,\nselectionResult.savedForecast.identifyingInformation)

  else Forecast missing, out of scope or retrieval failed
    Page -> Page : displaySelectedForecastUnavailable(selectionResult.reason)
  end

  deactivate Page
end

@enduml