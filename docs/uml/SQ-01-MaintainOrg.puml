@startuml
autonumber

actor Administrator as Admin
participant "OrganizationController" as Ctrl
participant "OrganizationService" as Svc
database "Database" as DB

Admin -> Ctrl: Submit organization data (Bank/Hospital)
activate Ctrl

Ctrl -> Svc: validateAndSave(data)
activate Svc

Svc -> DB: Check existing identifiers & validity
activate DB
DB --> Svc: Return validation result
deactivate DB

alt Valid Data
    Svc -> DB: Save organization record
    activate DB
    DB --> Svc: Return saved record ID
    deactivate DB
    Svc --> Ctrl: Success response with identifier
    Ctrl --> Admin: Show success details
else Duplicate or Invalid Data
    Svc --> Ctrl: Validation/Duplicate error
    Ctrl --> Admin: Return error message
end

deactivate Svc
deactivate Ctrl
@enduml