@startuml
skinparam DefaultTextAlignment center

start
:Administrator chooses to add/edit Bank or Hospital;
:Enter organization changes/details;
:System validates input data;

if (Are inputs valid?) then (yes)
    :Save organization record to Database;
    :Associate staff and operational constraints;
    :Show organization details and confirmation;
else (no)
    :Return error message to form;
    detach
endif

if (Deactivation requested?) then (yes)
    :Set organization status to inactive;
    :Preserve all linked historical records;
else (no)
    :Keep organization active;
endif

stop
@enduml